//
// @author LazyBear 
// List of all my indicators: https://www.tradingview.com/v/4IneGo8h/
//
// ============================================================================
// Squeeze Momentum Indicator (挤压动量指标) - 详细代码解释
// ============================================================================
// 
// 【指标概述】
// 这是一个结合波动性分析和动量分析的综合性技术指标，主要用于：
// 1. 识别市场低波动性的"挤压"状态
// 2. 预测挤压释放后的突破方向
// 3. 提供趋势突破的交易信号
//
// 【核心原理】
// - 通过比较布林带和肯特纳通道的相对位置判断市场挤压状态
// - 使用线性回归计算价格动量，预测突破方向
// - 当布林带被肯特纳通道包含时，表示市场处于低波动性挤压状态
// - 挤压状态通常预示着即将出现大幅价格波动
//
study(shorttitle = "SQZMOM_LB", title="Squeeze Momentum Indicator [LazyBear]", overlay=false)

// ============================================================================
// 【输入参数设置】
// ============================================================================
length = input(20, title="BB Length")          // 布林带计算周期，默认20期
mult = input(2.0,title="BB MultFactor")        // 布林带标准差倍数，默认2.0倍
lengthKC=input(20, title="KC Length")          // 肯特纳通道计算周期，默认20期
multKC = input(1.5, title="KC MultFactor")     // 肯特纳通道波幅倍数，默认1.5倍

// 是否使用真实波幅(True Range)计算肯特纳通道
// True Range考虑了跳空缺口，能更准确反映市场波动性
useTrueRange = input(true, title="Use TrueRange (KC)", type=bool)

// ============================================================================
// 【布林带(Bollinger Bands)计算】
// ============================================================================
// 布林带由三条线组成：中轨(移动平均线)、上轨、下轨
// 上下轨距离中轨的距离 = 标准差 × 倍数
// 布林带主要用于衡量价格的相对高低和波动性
source = close                                 // 数据源：收盘价
basis = sma(source, length)                    // 中轨：20期简单移动平均线
dev = multKC * stdev(source, length)           // 标准差乘以倍数，注意这里用的是multKC而不是mult
upperBB = basis + dev                          // 上轨 = 中轨 + 标准差×倍数
lowerBB = basis - dev                          // 下轨 = 中轨 - 标准差×倍数

// ============================================================================
// 【肯特纳通道(Keltner Channel)计算】
// ============================================================================
// 肯特纳通道基于移动平均线和平均真实波幅(ATR)构建
// 相比布林带，肯特纳通道对价格波动的反应更加平滑
ma = sma(source, lengthKC)                     // 中轨：20期简单移动平均线

// 计算波幅：可选择真实波幅(TR)或简单的高低价差
// 真实波幅 = max(高-低, abs(高-前收), abs(低-前收))
// 真实波幅能更好地捕捉跳空缺口对波动性的影响
range = useTrueRange ? tr : (high - low)       

rangema = sma(range, lengthKC)                 // 波幅的20期移动平均
upperKC = ma + rangema * multKC                // 上轨 = 中轨 + 平均波幅×倍数
lowerKC = ma - rangema * multKC                // 下轨 = 中轨 - 平均波幅×倍数

// ============================================================================
// 【挤压状态判断 - 指标核心逻辑】
// ============================================================================
// 挤压状态通过比较布林带和肯特纳通道的相对位置来判断：
// 
// sqzOn (挤压开启)：布林带完全位于肯特纳通道内部
// - 条件：布林带下轨 > 肯特纳下轨 且 布林带上轨 < 肯特纳上轨
// - 含义：市场波动性极低，价格被严重压缩
// - 预示：即将出现大幅价格波动（突破）
// - 显示：黑色点
sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)

// sqzOff (挤压关闭)：布林带完全位于肯特纳通道外部  
// - 条件：布林带下轨 < 肯特纳下轨 且 布林带上轨 > 肯特纳上轨
// - 含义：市场波动性正常，价格活跃
// - 预示：正常的价格波动状态
// - 显示：灰色点
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)

// noSqz (无挤压)：过渡状态
// - 条件：既不满足sqzOn也不满足sqzOff的条件
// - 含义：布林带和肯特纳通道部分重叠，处于过渡状态
// - 预示：状态转换中，需要观察后续发展
// - 显示：蓝色点
noSqz  = (sqzOn == false) and (sqzOff == false)

// ============================================================================
// 【动量值计算 - 预测突破方向】
// ============================================================================
// 这个复杂的公式用于计算价格相对于"中心价格"的动量偏差
// 通过线性回归分析这个偏差的趋势，预测价格突破方向

// 步骤分解：
// 1. highest(high, lengthKC) - 获取20期内的最高价
// 2. lowest(low, lengthKC) - 获取20期内的最低价  
// 3. avg(最高价, 最低价) - 计算高低价的中点
// 4. sma(close, lengthKC) - 计算20期收盘价移动平均
// 5. avg(高低中点, 收盘均价) - 得到一个"中心价格"
// 6. source - 中心价格 - 计算当前价格与中心价格的偏差
// 7. linreg(偏差, 20期, 0) - 对偏差进行线性回归，得到动量趋势值
//
// 这个动量值的含义：
// - 正值：价格动量向上，可能向上突破
// - 负值：价格动量向下，可能向下突破
// - 数值大小：反映动量强度
val = linreg(source  -  avg(avg(highest(high, lengthKC), lowest(low, lengthKC)),sma(close,lengthKC)), 
            lengthKC,0)

// ============================================================================
// 【颜色编码系统】
// ============================================================================
// 动量柱状图颜色逻辑：通过颜色变化直观显示动量方向和强度变化
// 
// 正动量（看涨）：
// - 亮绿色(lime)：正动量且在增强 → 强烈看涨信号
// - 绿色(green)：正动量但在减弱 → 看涨信号减弱，可能见顶
//
// 负动量（看跌）：
// - 红色(red)：负动量且在加深 → 强烈看跌信号  
// - 暗红色(maroon)：负动量但在减弱 → 看跌信号减弱，可能见底
bcolor = iff( val > 0, 
            iff( val > nz(val[1]), lime, green),      // 正值：上升用亮绿，下降用绿
            iff( val < nz(val[1]), red, maroon))      // 负值：下降用红，上升用暗红

// 挤压状态指示点颜色：
// - 蓝色：无挤压状态(过渡状态)
// - 黑色：挤压开启状态(重要信号！)  
// - 灰色：挤压关闭状态(正常状态)
scolor = noSqz ? blue : sqzOn ? black : gray 

// ============================================================================
// 【图形绘制】
// ============================================================================
// 绘制动量柱状图：主要的交易信号来源
// - 柱子高度：动量强度
// - 柱子颜色：动量方向和变化趋势
// - 零轴上方：看涨动量
// - 零轴下方：看跌动量
plot(val, color=bcolor, style=histogram, linewidth=4)

// 绘制挤压状态指示点：在零轴上显示当前挤压状态
// - 这些点是交易时机的重要参考
// - 黑色点出现时要特别关注，通常预示着大行情即将到来
plot(0, color=scolor, style=cross, linewidth=2)

// ============================================================================
// 【交易信号解读和应用策略】
// ============================================================================
//
// 【最佳交易时机识别】：
// 1. 等待挤压信号：当零轴出现黑色点时，表示市场进入挤压状态
//    - 此时不要急于进场，而是做好准备
//    - 挤压状态可能持续数根K线
//
// 2. 确认突破方向：当黑色点消失（变为灰色或蓝色）时
//    - 同时观察动量柱子的颜色和方向
//    - 亮绿色柱子：强烈看涨突破信号
//    - 红色柱子：强烈看跌突破信号
//
// 3. 跟随趋势：根据柱子颜色变化调整策略
//    - 柱子颜色变亮：趋势加强，可以加仓
//    - 柱子颜色变暗：趋势减弱，考虑减仓或止盈
//
// 【风险控制要点】：
// - 挤压状态时不要重仓，因为突破方向不确定
// - 假突破风险：有时挤压释放后会出现假突破，需要结合其他指标确认
// - 止损设置：可以在挤压区间的边界设置止损
//
// 【指标优势】：
// - 能够提前识别大行情的酝酿阶段
// - 结合了波动性和动量两个维度的分析
// - 信号相对清晰，适合程序化交易
//
// 【指标局限】：
// - 在震荡市中可能产生较多假信号
// - 需要结合趋势分析和支撑阻力位使用
// - 对参数设置较为敏感，不同品种可能需要调整参数
//
// ============================================================================
